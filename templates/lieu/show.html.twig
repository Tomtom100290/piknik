{% extends 'base.html.twig' %}

{% block title %}Lieu{% endblock %}

{% block body %}
    <h1>Lieu</h1>




   <div class="EquimShow">
    {% if lieu.fkEquipement|length > 0 %}
        {% for equipement in lieu.fkEquipement %}
            <div class="Equimnt">
                <div class="EquimntNom">
                    <h3>{{ equipement.nom }}</h3>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div>Aucun équipement.</div>
    {% endif %}
</div>




    </div>
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ lieu.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ lieu.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ lieu.description }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ lieu.statut ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Date_creat</th>
                <td>{{ lieu.dateCreat ? lieu.dateCreat|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Etat</th>
                <td>{{ lieu.etat.value }}</td>
            </tr>
            <tr>
                <th>Images</th>
    <td>
        {% if lieu.images|length > 0 %}
            {% for image in lieu.images %}
                <img src="{{ asset('uploads/lieux/' ~ image.imageName) }}"
                     alt="Image du lieu"
                     style="max-height: 100px; margin: 5px;">
            {% endfor %}
        {% else %}
            <p>Aucune image disponible</p>
        {% endif %}
    </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_lieu_index') }}">back to list</a>

    <a href="{{ path('app_lieu_edit', {'id': lieu.id}) }}">edit</a>

    {{ include('lieu/_delete_form.html.twig') }}
    <div class="lieu-details">
    <h1>{{ lieu.nom }}</h1>
    
    
        <button 
            class="btn-favoris" 
            data-lieu-id="{{ lieu.id }}"
            data-is-favori="{{ is_favori ? 'true' : 'false' }}"
        >
            <span class="heart-icon">
                {% if is_favori %}
                    ❤️
                {% else %}
                    🤍
                {% endif %}
            </span>
            <span class="favoris-text">
                {{ is_favori ? 'Retirer des favoris' : 'Ajouter aux favoris' }}
            </span>
        </button>
    
    
    {# Autres informations du lieu #}
</div>
❤️
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/favoris.js') }}"></script>
{% endblock %}
